# Copy to .env and fill in your values. Never commit .env to source control.

# Bybit API credentials
# Use testnet keys by default
BYBIT_API_KEY=your_testnet_api_key_here
BYBIT_API_SECRET=your_testnet_api_secret_here

# Set to "true" to go live (mainnet). Default is testnet.
BYBIT_TESTNET=true

# Optional: Telegram alerting
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
